# Dockerfile.inference

# ---- Stage 1: build the wheel ----
FROM python:3.13-slim AS builder

WORKDIR /build

RUN pip --no-cache-dir install --upgrade pip build

COPY pyproject.toml README.md LICENSE ./
COPY src/ src/

RUN python -m build --wheel --outdir /dist

# ---- Stage 2: runtime ----
FROM python:3.13-slim

WORKDIR /app

COPY --from=builder /dist/*.whl /tmp/
RUN pip --no-cache-dir install --upgrade pip \
    && pip --no-cache-dir install /tmp/*.whl \
    && rm -rf /tmp/*.whl

ENV PYTHONUNBUFFERED=TRUE
ENV PYTHONDONTWRITEBYTECODE=TRUE
ENV TITANIC_BASE_DIR=/app
ENV MODEL_DIR=/app/output/model
ENV OUTPUT_DIR=/app/output

# Model artifacts produced by the training stage
COPY output/model/ /app/output/model/

EXPOSE 8080

ENTRYPOINT ["uvicorn", "titanic.api.main:app", "--host", "0.0.0.0", "--port", "8080"]
