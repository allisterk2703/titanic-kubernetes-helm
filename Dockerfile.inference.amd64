# syntax=docker/dockerfile:1
# Dockerfile.inference.amd64
#
# Same as Dockerfile.inference, but installs from the private index given by
# PIP_INDEX_URL (.env). Built by: make build-inference ARCH=amd64
# Passed as a BuildKit secret, not ARG/--build-arg: a build arg's value is
# readable in `docker history` even though it never lands in the final
# image's env. The secret is mounted only for the RUN that needs it.

# ---- Stage 1: build the wheel ----
FROM python:3.13-slim AS builder

WORKDIR /build

RUN --mount=type=secret,id=pip_index_url \
    PIP_INDEX_URL=$(cat /run/secrets/pip_index_url 2>/dev/null || true) \
    pip --no-cache-dir install --upgrade pip build

COPY pyproject.toml README.md LICENSE ./
COPY src/ src/

RUN python -m build --wheel --outdir /dist

# ---- Stage 2: runtime ----
FROM python:3.13-slim

WORKDIR /app

COPY --from=builder /dist/*.whl /tmp/
RUN --mount=type=secret,id=pip_index_url \
    export PIP_INDEX_URL=$(cat /run/secrets/pip_index_url 2>/dev/null || true) \
    && pip --no-cache-dir install --upgrade pip \
    && pip --no-cache-dir install /tmp/*.whl \
    && rm -rf /tmp/*.whl

ENV PYTHONUNBUFFERED=TRUE
ENV PYTHONDONTWRITEBYTECODE=TRUE
ENV TITANIC_BASE_DIR=/app
ENV MODEL_DIR=/app/output/model
ENV OUTPUT_DIR=/app/output

# Model artifacts produced by the training stage
COPY output/model/ /app/output/model/

EXPOSE 8080

ENTRYPOINT ["uvicorn", "titanic.api.main:app", "--host", "0.0.0.0", "--port", "8080"]
